<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>KonnectMac</title>
    <options customize="never" require-scripts="false"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <pkg-ref id="com.konnectmac.app"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.konnectmac.app"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.konnectmac.app" visible="false">
        <pkg-ref id="com.konnectmac.app"/>
    </choice>
    <pkg-ref id="com.konnectmac.app" version="1.0" onConclusion="none">KonnectMac-component.pkg</pkg-ref>
</installer-gui-script>
